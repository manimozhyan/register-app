pipeline {

    agent {
        label 'Jenkins-Agent'
    }

    tools {
        jdk 'java17'
        maven 'Maven3'
    }

    environment {
        APP_NAME = "register-app-pipeline"
        RELEASE = "1.0.0"
        DOCKER_USER = "manimozhyan"

        IMAGE_NAME = "${DOCKER_USER}/${APP_NAME}"
        IMAGE_TAG = "${RELEASE}-${BUILD_NUMBER}"

        JENKINS_API_TOKEN = credentials("JENKINS_API_TOKEN")
    }

    stages {

        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from SCM') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github',
                    url: 'https://github.com/manimozhyan/register-app'
                )
            }
        }

        stage('Build Application') {
            steps {
                sh '''
                    echo "========================================="
                    echo "Building Java Application"
                    echo "========================================="

                    mvn clean package
                '''
            }
        }

        stage('Test Application') {
            steps {
                sh '''
                    echo "========================================="
                    echo "Running Tests"
                    echo "========================================="

                    mvn test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv(credentialsId: 'jenkins-sonar-token') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    echo "========================================="
                    echo "Building Docker Image"
                    echo "IMAGE_NAME = ${IMAGE_NAME}"
                    echo "IMAGE_TAG  = ${IMAGE_TAG}"
                    echo "========================================="

                    docker build \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        .

                    docker tag \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        ${IMAGE_NAME}:latest

                    docker images | grep ${APP_NAME}
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    echo "========================================="
                    echo "Running Trivy Security Scan"
                    echo "========================================="

                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy image \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        --no-progress \
                        --scanners vuln \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --format table
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {

                    echo "========================================="
                    echo "Pushing Docker Image to Docker Hub"
                    echo "========================================="

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub'
                    ) {

                        def dockerImage =
                            docker.image("${IMAGE_NAME}:${IMAGE_TAG}")

                        dockerImage.push("${IMAGE_TAG}")
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Cleanup Docker Artifacts') {
            steps {
                sh '''
                    echo "Cleaning Docker images..."

                    docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true
                    docker rmi ${IMAGE_NAME}:latest || true

                    docker image prune -f || true
                '''
            }
        }

        stage('Trigger CD Pipeline') {
            steps {
                script {

                    echo "========================================="
                    echo "Triggering CD Pipeline"
                    echo "IMAGE_TAG = ${IMAGE_TAG}"
                    echo "========================================="

                    sh """
                        curl -v -k \
                        --user "manimozhyan:${JENKINS_API_TOKEN}" \
                        -X POST \
                        -H 'cache-control: no-cache' \
                        -H 'content-type: application/x-www-form-urlencoded' \
                        --data 'IMAGE_TAG=${IMAGE_TAG}' \
                        'http://ec2-15-207-18-245.ap-south-1.compute.amazonaws.com:8080/job/gitops-register-app-cd/buildWithParameters?token=gitops-token'
                    """
                }
            }
        }
    }

    post {

        success {
            echo '''
            =========================================
            CI PIPELINE SUCCESS
            =========================================

            Application built successfully.
            Docker image pushed successfully.
            CD pipeline triggered successfully.

            =========================================
            '''
        }

        failure {
            echo '''
            =========================================
            CI PIPELINE FAILED
            =========================================

            Check the failed stage above.

            =========================================
            '''
        }
    }
}
